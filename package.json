{
  "name": "@rootnative/game-engine",
  "version": "0.0.0-alpha.2",
  "description": "2D and 3D game engine for React Native and Expo Go: an ECS core, a fixed-timestep loop, a Skia renderer and a three.js renderer, with no native code.",
  "keywords": [
    "expo",
    "expo-go",
    "react-native",
    "game-engine",
    "ecs",
    "skia",
    "three",
    "reanimated",
    "2d",
    "3d"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rootnative/game-engine.git"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./renderers/skia": {
      "types": "./dist/renderers/skia/index.d.ts",
      "react-native": "./src/renderers/skia/index.ts",
      "import": "./dist/renderers/skia/index.js",
      "default": "./dist/renderers/skia/index.js"
    },
    "./renderers/three": {
      "types": "./dist/renderers/three/index.d.ts",
      "react-native": "./src/renderers/three/index.ts",
      "import": "./dist/renderers/three/index.js",
      "default": "./dist/renderers/three/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:llms": "node scripts/build-llms-full.mjs",
    "build:brand": "node scripts/build-brand.mjs",
    "typecheck": "tsc --noEmit && pnpm --filter example typecheck && pnpm --filter example-3d typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,cjs,mjs,json}\"",
    "test": "vitest run",
    "prepack": "pnpm build && pnpm build:llms",
    "start": "pnpm --filter example start",
    "ios": "pnpm --filter example ios",
    "android": "pnpm --filter example android",
    "web": "pnpm --filter example web",
    "start:3d": "pnpm --filter example-3d start",
    "ios:3d": "pnpm --filter example-3d ios",
    "android:3d": "pnpm --filter example-3d android",
    "web:3d": "pnpm --filter example-3d web"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.14.0 <3.0.0",
    "expo-asset": ">=58.0.0 <59.0.0",
    "expo-file-system": ">=58.0.0 <59.0.0",
    "expo-gl": "~58.0.0",
    "expo-three": "^8.0.0",
    "react": ">=19.3.0 <19.4.0",
    "react-native": ">=0.88.0 <0.89.0",
    "react-native-gesture-handler": ">=3.3.0 <4.0.0",
    "react-native-reanimated": ">=4.7.0 <4.8.0",
    "react-native-worklets": ">=0.13.0 <0.14.0",
    "three": "^0.166.0"
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": {
      "optional": true
    },
    "expo-gl": {
      "optional": true
    },
    "expo-three": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shopify/react-native-skia": "2.14.0",
    "@types/react": "~19.3.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "prettier": "^3.10.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.33.0"
}
