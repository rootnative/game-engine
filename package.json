{
  "name": "@rootnative/game-engine",
  "version": "0.0.0-alpha.1",
  "description": "2D (and soon 3D) game engine for React Native + Expo Go. Skia-based renderer, ECS core, fixed-timestep loop, no native code.",
  "keywords": [
    "expo",
    "expo-go",
    "react-native",
    "game-engine",
    "ecs",
    "skia",
    "reanimated",
    "2d"
  ],
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./renderers/skia": {
      "types": "./dist/renderers/skia/index.d.ts",
      "react-native": "./src/renderers/skia/index.ts",
      "import": "./dist/renderers/skia/index.js",
      "default": "./dist/renderers/skia/index.js"
    },
    "./renderers/three": {
      "types": "./dist/renderers/three/index.d.ts",
      "react-native": "./src/renderers/three/index.ts",
      "import": "./dist/renderers/three/index.js",
      "default": "./dist/renderers/three/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:llms": "node scripts/build-llms-full.mjs",
    "build:brand": "node scripts/build-brand.mjs",
    "typecheck": "tsc --noEmit && pnpm --filter example typecheck && pnpm --filter example-3d typecheck",
    "prepack": "pnpm build && pnpm build:llms",
    "start": "pnpm --filter example start",
    "ios": "pnpm --filter example ios",
    "android": "pnpm --filter example android",
    "web": "pnpm --filter example web",
    "start:3d": "pnpm --filter example-3d start",
    "ios:3d": "pnpm --filter example-3d ios",
    "android:3d": "pnpm --filter example-3d android",
    "web:3d": "pnpm --filter example-3d web"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.6.0 <3.0.0",
    "expo-asset": ">=57.0.0 <58.0.0",
    "expo-file-system": ">=57.0.0 <58.0.0",
    "expo-gl": "~57.0.0",
    "expo-three": "^8.0.0",
    "react": ">=19.2.0 <19.3.0",
    "react-native": ">=0.86.0 <0.87.0",
    "react-native-gesture-handler": ">=2.32.0 <3.0.0",
    "react-native-reanimated": ">=4.5.0 <4.6.0",
    "react-native-worklets": ">=0.10.0 <0.11.0",
    "three": "^0.166.0"
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": { "optional": true },
    "expo-gl": { "optional": true },
    "expo-three": { "optional": true },
    "three": { "optional": true }
  },
  "devDependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "@types/react": "~19.2.0",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3"
  }
}
